{
  "manifest_version": 3,
  "name": "ETH Price Badge",
  "version": "1.0.0",
  "description": "Shows the ETH price on the toolbar badge and refreshes every 30 seconds.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://api.binance.com/*", "https://api.coinbase.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ETH",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
